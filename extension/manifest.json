{
  "manifest_version": 3,
  "name": "Shopify Dark Admin",
  "version": "1.0.0",
  "description": "Dark mode for the Shopify admin",
  "permissions": ["storage"],
  "host_permissions": [
    "https://admin.shopify.com/*",
    "https://*.shopifyapps.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.shopifyapps.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/dark.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
